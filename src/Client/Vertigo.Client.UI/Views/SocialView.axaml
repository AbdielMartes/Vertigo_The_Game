<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Vertigo.Client.UI.ViewModels"
             xmlns:models="using:Vertigo.Contracts.Models"
             xmlns:resources="using:Vertigo.Client.UI.Resources"
             xmlns:conv="using:Avalonia.Data.Converters"
             x:Class="Vertigo.Client.UI.Views.SocialView"
             x:DataType="vm:SocialViewModel" x:CompileBindings="True">
    <UserControl.Resources>
        <resources:AvatarImageConverter x:Key="AvatarImage"/>
    </UserControl.Resources>
    <ScrollViewer Background="{DynamicResource ColorCanvas}"
                  HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
        <StackPanel MaxWidth="{DynamicResource ContentMaxWidth}"
                    Margin="{DynamicResource MarginScreen}" Spacing="{DynamicResource Space16}">
            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="18">
                <Button Grid.Column="0" Classes="vertigo-button neutral" Command="{Binding BackCommand}"
                        AutomationProperties.Name="{Binding BackText}" TabIndex="0">
                    <Path Classes="vertigo-icon" Data="{StaticResource IconBack}"/>
                </Button>
                <TextBlock Grid.Column="1" Classes="vertigo-title"
                           VerticalAlignment="Center" TextWrapping="Wrap" Text="{Binding HeadingText}"/>
                <Button Grid.Column="2" Classes="vertigo-button neutral" TabIndex="1"
                        Command="{Binding RefreshCommand}" Content="{Binding RefreshText}"/>
            </Grid>
            <ContentControl Classes="vertigo-message"
                            IsVisible="{Binding ErrorMessage,
                                       Converter={x:Static conv:StringConverters.IsNotNullOrEmpty}}"
                            AutomationProperties.LiveSetting="Assertive">
                <TextBlock Classes="vertigo-message-text" Text="{Binding ErrorMessage}"/>
            </ContentControl>
            <TabControl Classes="vertigo-tabs" SelectedIndex="0" TabIndex="2">
                <TabItem Header="{Binding FriendsTabText}">
                    <Grid RowDefinitions="Auto,Auto,*,Auto" RowSpacing="14" Margin="16">
                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <TextBox Classes="vertigo-input" Width="260" MaxLength="20" TabIndex="3"
                                     PlaceholderText="{Binding SearchText}" Text="{Binding Friends.SearchTerm, Mode=TwoWay}"
                                     AutomationProperties.Name="{Binding SearchText}"/>
                            <Button Classes="vertigo-button secondary" TabIndex="4"
                                    Content="{Binding SearchText}" Command="{Binding Friends.SearchCommand}"/>
                        </StackPanel>
                        <ContentControl Grid.Row="1" Classes="vertigo-message"
                                        IsVisible="{Binding Friends.ErrorMessage,
                                                   Converter={x:Static conv:StringConverters.IsNotNullOrEmpty}}"
                                        AutomationProperties.LiveSetting="Assertive">
                            <TextBlock Classes="vertigo-message-text" Text="{Binding Friends.ErrorMessage}"/>
                        </ContentControl>
                        <Grid Grid.Row="2" ColumnDefinitions="*,*" ColumnSpacing="18">
                            <StackPanel Spacing="8">
                                <TextBlock Classes="vertigo-section" Text="{Binding FriendsTabText}"/>
                                <ListBox Classes="vertigo-list" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                         ItemsSource="{Binding Friends.Friends}"
                                         SelectedItem="{Binding SelectedFriend, Mode=TwoWay}" TabIndex="5"
                                         MinHeight="180" MaxHeight="320">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate x:DataType="models:FriendEntry">
                                            <StackPanel Orientation="Horizontal" Spacing="8" Margin="8">
                                                <Image Width="28" Height="28" Source="{Binding AvatarId, Converter={StaticResource AvatarImage}}"/>
                                                <TextBlock Text="{Binding Username}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                            </StackPanel>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                                <Button Classes="vertigo-button neutral" Command="{Binding Friends.RemoveCommand}"
                                        Content="{Binding RemoveFriendText}" TabIndex="6"/>
                                <Button Classes="vertigo-button neutral"
                                        IsVisible="{Binding SelectedFriend, Converter={x:Static conv:ObjectConverters.IsNotNull}}"
                                        Command="{Binding ViewProfileCommand}"
                                        CommandParameter="{Binding SelectedFriend.PlayerId}"
                                        Content="{Binding ViewProfileText}"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Spacing="8">
                                <TextBlock Classes="vertigo-section" Text="{Binding SearchResultsText}"/>
                                <ListBox Classes="vertigo-list" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                         ItemsSource="{Binding Friends.SearchResults}"
                                         SelectedItem="{Binding SelectedSearch, Mode=TwoWay}" TabIndex="7"
                                         MinHeight="180" MaxHeight="320">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate x:DataType="models:PlayerSearchEntry">
                                            <StackPanel Orientation="Horizontal" Spacing="8" Margin="8">
                                                <Image Width="28" Height="28" Source="{Binding AvatarId, Converter={StaticResource AvatarImage}}"/>
                                                <TextBlock Text="{Binding Username}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                            </StackPanel>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                                <Button Classes="vertigo-button primary" TabIndex="8"
                                        Content="{Binding SendRequestText}" Command="{Binding Friends.SendRequestCommand}"/>
                                <Button Classes="vertigo-button neutral"
                                        IsVisible="{Binding SelectedSearch, Converter={x:Static conv:ObjectConverters.IsNotNull}}"
                                        Command="{Binding ViewProfileCommand}"
                                        CommandParameter="{Binding SelectedSearch.PlayerId}"
                                        Content="{Binding ViewProfileText}"/>
                            </StackPanel>
                        </Grid>
                    </Grid>
                </TabItem>
                <TabItem Header="{Binding RequestsTabText}">
                    <StackPanel Margin="16" Spacing="12">
                        <ListBox Classes="vertigo-list" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                         ItemsSource="{Binding Friends.PendingRequests}" TabIndex="9"
                                 SelectedItem="{Binding SelectedRequest, Mode=TwoWay}" MinHeight="200" MaxHeight="360">
                            <ListBox.ItemTemplate>
                                <DataTemplate x:DataType="models:FriendshipInvitationEntry">
                                    <StackPanel Orientation="Horizontal" Spacing="8" Margin="8">
                                        <Image Width="28" Height="28" Source="{Binding AvatarId, Converter={StaticResource AvatarImage}}"/>
                                        <TextBlock Text="{Binding SenderUsername}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                    </StackPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                        <ContentControl Classes="vertigo-message"
                                        IsVisible="{Binding Friends.ErrorMessage,
                                                   Converter={x:Static conv:StringConverters.IsNotNullOrEmpty}}"
                                        AutomationProperties.LiveSetting="Assertive">
                            <TextBlock Classes="vertigo-message-text" Text="{Binding Friends.ErrorMessage}"/>
                        </ContentControl>
                        <WrapPanel ItemSpacing="{DynamicResource Space12}" LineSpacing="{DynamicResource Space8}">
                            <Button Classes="vertigo-button primary" Content="{Binding AcceptText}" TabIndex="10"
                                    Command="{Binding Friends.AcceptCommand}"/>
                            <Button Classes="vertigo-button neutral" Content="{Binding RejectText}" TabIndex="11"
                                    Command="{Binding Friends.RejectCommand}"/>
                            <Button Classes="vertigo-button neutral"
                                    IsVisible="{Binding SelectedRequest, Converter={x:Static conv:ObjectConverters.IsNotNull}}"
                                    Command="{Binding ViewProfileCommand}"
                                    CommandParameter="{Binding SelectedRequest.SenderId}"
                                    Content="{Binding ViewProfileText}"/>
                        </WrapPanel>
                    </StackPanel>
                </TabItem>
                <TabItem Header="{Binding InvitationsTabText}">
                    <StackPanel Margin="16" Spacing="12">
                        <ListBox Classes="vertigo-list" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                         ItemsSource="{Binding Invitations.PendingInvitations}" TabIndex="12"
                                 SelectedItem="{Binding SelectedInvitation, Mode=TwoWay}"
                                 MinHeight="200" MaxHeight="360">
                            <ListBox.ItemTemplate>
                                <DataTemplate x:DataType="models:LobbyInvitationEntry">
                                    <StackPanel Orientation="Horizontal" Spacing="8" Margin="8">
                                        <Image Width="28" Height="28" Source="{Binding AvatarId, Converter={StaticResource AvatarImage}}"/>
                                        <StackPanel>
                                            <TextBlock Text="{Binding SenderUsername}" TextTrimming="CharacterEllipsis"/>
                                            <TextBlock FontFamily="{DynamicResource FontMono}"
                                                       Text="{Binding LobbyCode}"/>
                                        </StackPanel>
                                    </StackPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                        <ContentControl Classes="vertigo-message"
                                        IsVisible="{Binding Invitations.ErrorMessage,
                                                   Converter={x:Static conv:StringConverters.IsNotNullOrEmpty}}"
                                        AutomationProperties.LiveSetting="Assertive">
                            <TextBlock Classes="vertigo-message-text" Text="{Binding Invitations.ErrorMessage}"/>
                        </ContentControl>
                        <WrapPanel ItemSpacing="{DynamicResource Space12}" LineSpacing="{DynamicResource Space8}">
                            <Button Classes="vertigo-button primary" Content="{Binding AcceptText}" TabIndex="13"
                                    Command="{Binding Invitations.AcceptCommand}"/>
                            <Button Classes="vertigo-button neutral" Content="{Binding RejectText}" TabIndex="14"
                                    Command="{Binding Invitations.DeclineCommand}"/>
                            <Button Classes="vertigo-button neutral"
                                    IsVisible="{Binding SelectedInvitation, Converter={x:Static conv:ObjectConverters.IsNotNull}}"
                                    Command="{Binding ViewProfileCommand}"
                                    CommandParameter="{Binding SelectedInvitation.SenderId}"
                                    Content="{Binding ViewProfileText}"/>
                        </WrapPanel>
                    </StackPanel>
                </TabItem>
                <TabItem Header="{Binding BlockedTabText}">
                    <StackPanel Margin="16" Spacing="12">
                        <ListBox Classes="vertigo-list" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                         ItemsSource="{Binding Blocked.BlockedPlayers}" TabIndex="15"
                                 SelectedItem="{Binding SelectedBlocked, Mode=TwoWay}" MinHeight="200" MaxHeight="360">
                            <ListBox.ItemTemplate>
                                <DataTemplate x:DataType="models:BlockedPlayerSummary">
                                    <StackPanel Orientation="Horizontal" Spacing="8" Margin="8">
                                        <Image Width="28" Height="28" Source="{Binding AvatarId, Converter={StaticResource AvatarImage}}"/>
                                        <TextBlock Text="{Binding Username}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                    </StackPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                        <ContentControl Classes="vertigo-message"
                                        IsVisible="{Binding Blocked.ErrorMessage,
                                                   Converter={x:Static conv:StringConverters.IsNotNullOrEmpty}}"
                                        AutomationProperties.LiveSetting="Assertive">
                            <TextBlock Classes="vertigo-message-text" Text="{Binding Blocked.ErrorMessage}"/>
                        </ContentControl>
                        <Button Classes="vertigo-button neutral" Content="{Binding UnblockText}"
                                TabIndex="16" Command="{Binding Blocked.UnblockCommand}"/>
                        <Button Classes="vertigo-button neutral"
                                IsVisible="{Binding SelectedBlocked, Converter={x:Static conv:ObjectConverters.IsNotNull}}"
                                Command="{Binding ViewProfileCommand}"
                                CommandParameter="{Binding SelectedBlocked.PlayerId}"
                                Content="{Binding ViewProfileText}"/>
                    </StackPanel>
                </TabItem>
            </TabControl>
        </StackPanel>
    </ScrollViewer>
</UserControl>
