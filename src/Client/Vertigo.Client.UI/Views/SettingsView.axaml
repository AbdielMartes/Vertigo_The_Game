<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Vertigo.Client.UI.ViewModels"
             xmlns:conv="using:Avalonia.Data.Converters"
             x:Class="Vertigo.Client.UI.Views.SettingsView"
             x:DataType="vm:SettingsViewModel"
             x:CompileBindings="True">
    <ScrollViewer Background="{DynamicResource ColorCanvas}">
        <StackPanel Margin="{DynamicResource MarginScreen}"
                    Spacing="{DynamicResource Space24}" MaxWidth="560">
            <DockPanel LastChildFill="True">
                <Button DockPanel.Dock="Left" Classes="vertigo-button neutral"
                        Command="{Binding BackCommand}" TabIndex="0"
                        AutomationProperties.Name="{Binding BackText}">
                    <Path Classes="vertigo-icon" Data="{StaticResource IconBack}"/>
                </Button>
                <TextBlock Classes="vertigo-title" Margin="24,0,0,0"
                           VerticalAlignment="Center" TextWrapping="Wrap" Text="{Binding HeadingText}"/>
            </DockPanel>
            <Border Classes="vertigo-card">
                <StackPanel Spacing="{DynamicResource Space16}">
                    <TextBlock Classes="vertigo-section" Text="{Binding LanguageText}"/>
                    <ComboBox Classes="vertigo-input" HorizontalAlignment="Stretch"
                              SelectedIndex="{Binding LanguageIndex, Mode=TwoWay}" TabIndex="1"
                              AutomationProperties.Name="{Binding LanguageText}">
                        <ComboBoxItem Content="{Binding SpanishText}"/>
                        <ComboBoxItem Content="{Binding EnglishText}"/>
                    </ComboBox>
                    <Button Classes="vertigo-button primary" HorizontalAlignment="Right" Command="{Binding SaveCommand}"
                            Content="{Binding SaveText}" TabIndex="2"/>
                    <ContentControl Classes="vertigo-message"
                                    IsVisible="{Binding ErrorMessage,
                                               Converter={x:Static conv:StringConverters.IsNotNullOrEmpty}}"
                                    AutomationProperties.LiveSetting="Assertive">
                        <TextBlock Classes="vertigo-message-text" Text="{Binding ErrorMessage}"/>
                    </ContentControl>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
