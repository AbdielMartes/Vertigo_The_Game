<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Vertigo.Client.UI.ViewModels"
             xmlns:rows="using:Vertigo.Client.UI.ViewModels.Presentation"
             xmlns:conv="using:Avalonia.Data.Converters"
             x:Class="Vertigo.Client.UI.Views.RankingView"
             x:DataType="vm:RankingViewModel"
             x:CompileBindings="True">
    <Border Classes="vertigo-screen" Padding="{DynamicResource MarginScreen}">
        <Grid RowDefinitions="Auto,Auto,Auto,*,Auto" RowSpacing="{DynamicResource Space12}" MaxWidth="900">
            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="16">
                <Button Classes="vertigo-button neutral" Content="{Binding BackText}" Command="{Binding BackCommand}"/>
                <TextBlock Grid.Column="1" Classes="vertigo-title"
                           VerticalAlignment="Center" TextWrapping="Wrap" Text="{Binding Title}"/>
                <Button Grid.Column="2" Classes="vertigo-button neutral" Content="{Binding RefreshText}"
                        Command="{Binding RefreshCommand}"/>
            </Grid>
            <ComboBox Grid.Row="1" Classes="vertigo-input" IsVisible="{Binding HasScopes}"
                      ItemsSource="{Binding ScopeLabels}"
                      SelectedIndex="{Binding ScopeIndex, Mode=TwoWay}"
                      AutomationProperties.Name="{Binding ScopeText}"/>
            <ContentControl Grid.Row="2" Classes="vertigo-message status"
                            IsVisible="{Binding Status, Converter={x:Static conv:StringConverters.IsNotNullOrEmpty}}"
                            AutomationProperties.LiveSetting="Polite">
                <TextBlock Classes="vertigo-message-text" Text="{Binding Status}"/>
            </ContentControl>
            <Border Grid.Row="3" Classes="vertigo-card" Padding="{DynamicResource PaddingControl}">
                <Grid RowDefinitions="Auto,*" RowSpacing="{DynamicResource Space8}">
                    <Grid ColumnDefinitions="28,32,*,75,75" ColumnSpacing="8" Margin="23,0,23,0">
                        <TextBlock Grid.Column="2"
                                   Classes="vertigo-secondary"
                                   FontWeight="SemiBold"
                                   Text="{Binding PlayerText}"/>
                        <TextBlock Grid.Column="3"
                                   Classes="vertigo-secondary"
                                   FontWeight="SemiBold"
                                   Text="{Binding WinsText}"
                                   TextAlignment="Right"
                                   TextWrapping="Wrap"/>
                        <TextBlock Grid.Column="4"
                                   Classes="vertigo-secondary"
                                   FontWeight="SemiBold"
                                   Text="{Binding FloorsText}"
                                   TextAlignment="Right"
                                   TextWrapping="Wrap"/>
                    </Grid>
                    <ListBox Grid.Row="1" Classes="vertigo-list"
                             ItemsSource="{Binding Rows}"
                             SelectedItem="{Binding SelectedRow, Mode=TwoWay}"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.ItemTemplate>
                            <DataTemplate x:DataType="rows:RankingRow">
                                <Border Padding="10">
                                    <Grid ColumnDefinitions="28,32,*,75,75" ColumnSpacing="8">
                                        <TextBlock Classes="vertigo-table-number" Text="{Binding Position}"/>
                                        <Image Grid.Column="1" Width="32" Height="32" Source="{Binding Avatar}"/>
                                        <TextBlock Grid.Column="2" Text="{Binding Username}" VerticalAlignment="Center"
                                                   TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Grid.Column="3"
                                                   Classes="vertigo-table-number"
                                                   Text="{Binding MatchesWon}"/>
                                        <TextBlock Grid.Column="4"
                                                   Classes="vertigo-table-number"
                                                   Text="{Binding FloorsBuilt}"/>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </Border>
            <Button Grid.Row="4" HorizontalAlignment="Right" Classes="vertigo-button neutral"
                    IsVisible="{Binding CanViewProfile}"
                    Command="{Binding ViewProfileCommand}"
                    Content="{Binding ViewProfileText}"/>
        </Grid>
    </Border>
</UserControl>
