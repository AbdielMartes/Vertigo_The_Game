<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Vertigo.Client.UI.ViewModels"
             xmlns:rows="using:Vertigo.Client.UI.ViewModels.Presentation"
             xmlns:conv="using:Avalonia.Data.Converters"
             x:Class="Vertigo.Client.UI.Views.ProfileView"
             x:DataType="vm:ProfileViewModel"
             x:CompileBindings="True">
    <UserControl.Styles>
        <Style Selector="TextBlock.profile-stat">
            <Setter Property="FontFamily" Value="{DynamicResource FontMono}"/>
            <Setter Property="Foreground" Value="{DynamicResource ColorAccent}"/>
            <Setter Property="FontSize" Value="{DynamicResource FontSizeSection}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
    </UserControl.Styles>
    <ScrollViewer Background="{DynamicResource ColorCanvas}"
                  HorizontalScrollBarVisibility="Disabled"
                  VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="{DynamicResource MarginScreen}"
                    MaxWidth="620"
                    Spacing="{DynamicResource Space12}">
            <DockPanel LastChildFill="True">
                <Button DockPanel.Dock="Left"
                        Classes="vertigo-button neutral"
                        IsEnabled="{Binding !SaveProfileCommand.IsRunning}"
                        Command="{Binding BackCommand}"
                        TabIndex="0"
                        AutomationProperties.Name="{Binding BackText}">
                    <Path Classes="vertigo-icon" Data="{StaticResource IconBack}"/>
                </Button>
                <TextBlock Classes="vertigo-title"
                           Margin="16,0,0,0"
                           VerticalAlignment="Center"
                           TextWrapping="Wrap"
                           Text="{Binding HeadingText}"/>
            </DockPanel>
            <Border Classes="vertigo-card" IsVisible="{Binding !IsEditing}">
                <StackPanel Spacing="{DynamicResource Space12}">
                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="{DynamicResource Space12}">
                        <Image Width="64" Height="64" Source="{Binding Avatar}"/>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock FontSize="{DynamicResource FontSizeSection}"
                                       FontWeight="Bold"
                                       TextWrapping="Wrap"
                                       Text="{Binding Username}"/>
                            <TextBlock Classes="vertigo-secondary" Text="{Binding AccountType}"/>
                        </StackPanel>
                    </Grid>
                    <StackPanel IsVisible="{Binding ShowStatistics}" Spacing="{DynamicResource Space12}">
                        <ContentControl Classes="vertigo-message status"
                                        AutomationProperties.LiveSetting="Polite">
                            <ContentControl.IsVisible>
                                <MultiBinding Converter="{x:Static conv:BoolConverters.And}">
                                    <Binding Path="!IsRecordAvailable"/>
                                    <Binding Path="RecordStatus"
                                             Converter="{x:Static conv:StringConverters.IsNotNullOrEmpty}"/>
                                </MultiBinding>
                            </ContentControl.IsVisible>
                            <TextBlock Classes="vertigo-message-text" Text="{Binding RecordStatus}"/>
                        </ContentControl>
                        <Grid IsVisible="{Binding IsRecordAvailable}"
                              ColumnDefinitions="*,*,*"
                              RowDefinitions="Auto,Auto"
                              ColumnSpacing="{DynamicResource Space8}"
                              RowSpacing="{DynamicResource Space4}">
                            <TextBlock Classes="profile-stat" Text="{Binding MatchesPlayed}"/>
                            <TextBlock Grid.Column="1" Classes="profile-stat" Text="{Binding MatchesWon}"/>
                            <TextBlock Grid.Column="2" Classes="profile-stat" TextWrapping="Wrap" Text="{Binding WinRate}"/>
                            <TextBlock Grid.Row="1" Classes="vertigo-secondary" Text="{Binding MatchesPlayedText}"/>
                            <TextBlock Grid.Row="1" Grid.Column="1"
                                       Classes="vertigo-secondary" Text="{Binding MatchesWonText}"/>
                            <TextBlock Grid.Row="1" Grid.Column="2"
                                       Classes="vertigo-secondary" Text="{Binding WinRateText}"/>
                        </Grid>
                        <Grid IsVisible="{Binding IsRecordAvailable}"
                              ColumnDefinitions="*,*"
                              RowDefinitions="Auto,Auto"
                              ColumnSpacing="{DynamicResource Space8}">
                            <TextBlock Classes="vertigo-secondary" Text="{Binding CreatedYearText}"/>
                            <TextBlock Grid.Column="1" Classes="vertigo-secondary" Text="{Binding CountryText}"/>
                            <TextBlock Grid.Row="1" TextWrapping="Wrap" Text="{Binding CreatedYear}"/>
                            <TextBlock Grid.Row="1" Grid.Column="1" TextWrapping="Wrap" Text="{Binding Country}"/>
                        </Grid>
                    </StackPanel>
                </StackPanel>
            </Border>
            <Button Classes="vertigo-button neutral" HorizontalAlignment="Right"
                    IsVisible="{Binding CanShowEdit}"
                    IsEnabled="{Binding IsRecordAvailable}"
                    Command="{Binding EditCommand}"
                    Content="{Binding EditProfileText}"/>
            <Border Classes="vertigo-card" IsVisible="{Binding IsEditing}">
                <StackPanel IsEnabled="{Binding !SaveProfileCommand.IsRunning}" Spacing="{DynamicResource Space8}">
                    <Grid ColumnDefinitions="Auto,*"
                          RowDefinitions="Auto,Auto,Auto"
                          ColumnSpacing="{DynamicResource Space8}"
                          RowSpacing="{DynamicResource Space8}">
                        <TextBlock Classes="vertigo-secondary"
                                   VerticalAlignment="Center"
                                   Text="{Binding UsernameText}"/>
                        <TextBox Grid.Column="1" Classes="vertigo-input"
                                 Text="{Binding DraftUsername, Mode=TwoWay}"
                                 MaxLength="{Binding UsernameMaximumLength}"
                                 AutomationProperties.Name="{Binding UsernameText}"/>
                        <TextBlock Grid.Row="1"
                                   Classes="vertigo-secondary"
                                   VerticalAlignment="Center"
                                   Text="{Binding CountryText}"/>
                        <AutoCompleteBox Grid.Row="1"
                                         Grid.Column="1"
                                         Classes="vertigo-input"
                                         ItemsSource="{Binding CountryChoices}"
                                         ItemFilter="{Binding CountryFilter}"
                                         Text="{Binding DraftCountryText, Mode=TwoWay}"
                                         MinimumPrefixLength="0"
                                         IsTextCompletionEnabled="False"
                                         PlaceholderText="{Binding CountrySearchText}"
                                         AutomationProperties.Name="{Binding CountryText}"/>
                        <TextBlock Grid.Row="2"
                                   Classes="vertigo-secondary"
                                   VerticalAlignment="Center"
                                   Text="{Binding AvatarText}"/>
                        <ComboBox Grid.Row="2"
                                  Grid.Column="1"
                                  Classes="vertigo-input"
                                  ItemsSource="{Binding AvatarChoices}"
                                  SelectedItem="{Binding DraftAvatar, Mode=TwoWay}"
                                  HorizontalAlignment="Stretch"
                                  AutomationProperties.Name="{Binding AvatarText}">
                            <ComboBox.ItemTemplate>
                                <DataTemplate x:DataType="rows:ProfileAvatarOption">
                                    <StackPanel Orientation="Horizontal" Spacing="{DynamicResource Space8}">
                                        <Image Width="28" Height="28" Source="{Binding Image}"/>
                                        <TextBlock VerticalAlignment="Center" Text="{Binding Name}"/>
                                    </StackPanel>
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                    </Grid>
                    <ContentControl Classes="vertigo-message"
                                    IsVisible="{Binding HasEditError}"
                                    AutomationProperties.LiveSetting="Assertive">
                        <TextBlock Classes="vertigo-message-text" Text="{Binding EditError}"/>
                    </ContentControl>
                    <WrapPanel ItemSpacing="{DynamicResource Space8}" LineSpacing="{DynamicResource Space8}">
                        <Button Classes="vertigo-button secondary"
                                Command="{Binding SaveProfileCommand}"
                                Content="{Binding SaveText}"/>
                        <Button Classes="vertigo-button neutral"
                                Command="{Binding CancelEditCommand}"
                                Content="{Binding CancelText}"/>
                    </WrapPanel>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
