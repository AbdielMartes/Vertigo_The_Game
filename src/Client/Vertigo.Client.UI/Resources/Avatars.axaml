<ResourceDictionary xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ResourceDictionary.MergedDictionaries>
        <ResourceInclude Source="avares://Vertigo.Client.UI/Themes/Tokens/Colors.axaml"/>
    </ResourceDictionary.MergedDictionaries>

    <DrawingImage x:Key="AvatarSkyline">
        <DrawingGroup>
            <GeometryDrawing Brush="{StaticResource ColorModuleBadge}">
                <GeometryDrawing.Geometry>
                    <EllipseGeometry Rect="0,0,64,64"/>
                </GeometryDrawing.Geometry>
            </GeometryDrawing>
            <GeometryDrawing Brush="{StaticResource ColorWhite}"
                             Geometry="M14,48 V31 H23 V24 H30 V15 H37 V9 H41 V15 H47 V32 H51 V48 Z"/>
            <GeometryDrawing Brush="{StaticResource ColorSnesYellow}"
                             Geometry="M35,23 H42 V29 H35 Z M35,34 H42 V40 H35 Z M21,36 H27 V43 H21 Z"/>
        </DrawingGroup>
    </DrawingImage>

    <DrawingImage x:Key="AvatarTower">
