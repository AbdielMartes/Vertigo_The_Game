            <GeometryDrawing Brush="{StaticResource ColorBoardSkylineFar}"
                             Geometry="M19,52 L23,18 L42,10 L47,52 Z"/>
            <GeometryDrawing Brush="{StaticResource ColorWhite}"
                             Geometry="M23,18 L42,10 L39,46 L23,52 Z"/>
            <GeometryDrawing Brush="{StaticResource ColorSnesBlue}"
                             Geometry="M27,22 L36,18 V23 L27,28 Z M27,33 L35,29 V34 L27,39 Z"/>
